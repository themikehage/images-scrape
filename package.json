{
  "name": "image-scraper",
  "version": "1.0.0",
  "description": "Scraper de imágenes de Bing",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts & vite --root src/web",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite --root src/web",
    "start": "node dist/server.js",
    "build": "tsc",
    "build:web": "cd src/web && npx vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
